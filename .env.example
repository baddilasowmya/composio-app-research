# Required to run scripts/research_agent.py and scripts/verify_sample.py.
# Groq's free tier covers groq/compound with built-in web search -- no
# separate search API or paid key needed to run this end to end.
# Get one at https://console.groq.com
GROQ_API_KEY=

# Required for the first-party Composio toolkit-catalog check in research_agent.py.
# Without this, the agent still runs but skips the Composio catalog lookup and
# relies on web search alone (a warning is printed).
COMPOSIO_API_KEY=
