# Set ONE of these three -- research_agent.py auto-detects which is present
# and uses that provider automatically (checked in this order).

# Option A -- free tier, fast: https://console.groq.com
GROQ_API_KEY=

# Option B: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option C -- many free/cheap models: https://openrouter.ai
OPENROUTER_API_KEY=
# Optional: pick a specific OpenRouter model (defaults to a free Llama model)
OPENROUTER_MODEL=

# Optional for all providers -- enables the first-party Composio
# toolkit-catalog check (skipped with a note if not set).
COMPOSIO_API_KEY=
